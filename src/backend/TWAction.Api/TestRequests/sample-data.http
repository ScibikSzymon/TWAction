###
# 8. LOAD TESTING DATA GENERATOR
# Use this pattern to generate large datasets
###

# Python script to generate troops data:
"""
for i in range(1, 1001):
    village_id = 10000 + i
    player_id = 50000 + (i // 20)  # 20 villages per player
    x = 500 + (i // 50)
    y = 500 + (i % 50)
    print(f"{village_id}\t{player_id}\t{x}\t{y}\t100\t50\t30\t20\t{150+i%50}\t10\t5\t8\t0\t0")
"""
