{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "ConnectionStrings": {
    "TWActionDatabase": "Host=localhost;Port=5432;Database=twaction;Username=postgres;Password=postgres"
  },
  "Google": {
    "ClientId": "id_here",
    "ClientSecret": "secret_here",
    "RedirectUri": "http://localhost:8000/auth/google/callback"
  },
  "Auth": {
    "CookieName": "TWAction.Session",
    "SessionExpiryHours": 8,
    "CookieSecure": true,
    "CookieSameSite": "Strict",
    "CookieDomain": ".yourdomain.com",
    "FrontendUrl": "https://twaction.example.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://twaction.example.com"
    ]
  },
  "GeneratorApi": {
    "BaseUrl": "https://localhost:7001"
  },
  "PlemionaRozpiskiApi": {
    "BaseUrl": "https://plemionarozpiski.pl",
    "ApiKey": "secret"
  }
}
